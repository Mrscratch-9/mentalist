{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Mentalist Archive",
  "version": "0.1.0",
  "mainBinaryName": "mentalist",
  "identifier": "com.mentalist.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "The Mentalist Archive", "width": 1440, "height": 900 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://tiles.localhost tiles://localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../public/tiles/california.*": "tiles/", "../public/tiles/austin.*": "tiles/" },
    "targets": ["nsis"],
    "licenseFile": "installer/que-se-instala.txt",
    "publisher": "The Mentalist Archive",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
