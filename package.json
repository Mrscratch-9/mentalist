{
  "name": "mentalist",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @mentalist/desktop dev",
    "tauri": "pnpm --filter @mentalist/desktop tauri",
    "data:build": "pnpm --filter @mentalist/pipeline build-data",
    "data:import": "pnpm --filter @mentalist/importer run import"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
